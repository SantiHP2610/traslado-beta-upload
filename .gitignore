# =============================================================================
# .gitignore — App Traslado Personal
# =============================================================================

# --- Secrets & environment variables ----------------------------------------
.env
frontend/.env

# --- Google API cache (regenerated automatically on each run) ----------------
.api_cache/

# --- Persistent geocoding caches (contain real addresses) --------------------
employees.json
venues.json

# --- Uploaded Excel files (may contain real event/staff data) ----------------
uploads/
*.xlsx
*.xls
~$*.xlsx
~$*.xls
# Exception: keep the generated sample file
!sample_data/evento_prueba.xlsx

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / frontend ---------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
dist/
*.local

# --- OS files ----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- IDEs --------------------------------------------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Claude Code --------------------------------------------------------------
.claude/
CLAUDE.md